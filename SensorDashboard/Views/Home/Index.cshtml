@{
    ViewData["Title"] = "Sensor Monitoring";
}

<div id="dashboard" data-hub-url="@ViewData["SensorHubUrl"]" class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Sensor Monitoring</h1>
        <small class="text-muted">Live ESP32 temperature &amp; humidity telemetry</small>
    </div>
    <div class="d-flex align-items-center gap-2">
        <small class="text-muted" id="last-updated"></small>
        <span class="badge text-bg-secondary" id="status-badge">Connecting&hellip;</span>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="stat-label">Temperature</div>
                <div class="stat-value text-orange" id="stat-temp">&ndash;</div>
                <small class="text-muted" id="stat-temp-range"></small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="stat-label">Humidity</div>
                <div class="stat-value text-sky" id="stat-humidity">&ndash;</div>
                <small class="text-muted">&nbsp;</small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="stat-label">Avg temperature</div>
                <div class="stat-value" id="stat-avg-temp">&ndash;</div>
                <small class="text-muted" id="stat-window-temp"></small>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="stat-label">Avg humidity</div>
                <div class="stat-value" id="stat-avg-humidity">&ndash;</div>
                <small class="text-muted" id="stat-window-humidity"></small>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h6 card-title mb-3">Recent history</h2>
        <div class="chart-container">
            <canvas id="history-chart"></canvas>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h6 card-title mb-3">Latest readings</h2>
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Temperature</th>
                    <th>Humidity</th>
                </tr>
            </thead>
            <tbody id="readings-body">
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">
                        No readings yet. Start the ESP32 simulator to stream data.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
