{
  "ConnectionStrings": {
    "SensorDatabase": "Data Source=sensor.db"
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "Topic": "sensors/temperature",
    "ClientId": "sensor-api",
    "RetrySeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
